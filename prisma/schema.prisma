generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model DanceCrew {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  image       String
  color       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  votes       Vote[]

  @@map("dance_crews")
}

model Vote {
  id          String    @id @default(uuid())
  crewId      Int
  fingerprint String    @unique
  ipAddress   String?
  userAgent   String?
  timestamp   DateTime  @default(now())
  crew        DanceCrew @relation(fields: [crewId], references: [id], onDelete: Cascade)

  @@index([crewId])
  @@index([fingerprint])
  @@index([timestamp])
  @@map("votes")
}

model VotingState {
  id               Int      @id @default(1)
  paused           Boolean  @default(false)
  updatedAt        DateTime @updatedAt
  overrideSchedule Boolean  @default(false)

  @@map("voting_state")
}
